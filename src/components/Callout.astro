---
// A marginal note in a pen colour: note (teal), warn (vermilion), tip (ochre).
interface Props { tone?: 'note' | 'warn' | 'tip'; title?: string }
const { tone = 'note', title } = Astro.props;
const LABEL = { note: 'Note', warn: 'Caution', tip: 'Tip' } as const;
---
<aside class:list={['callout', `callout--${tone}`]} role="note">
  <p class="callout__label">{LABEL[tone]}{title && <span class="callout__title"> · {title}</span>}</p>
  <div class="callout__body"><slot /></div>
</aside>
<style>
  .callout {
    --pen: var(--teal); --pen-ink: var(--teal-ink);
    background: var(--paper-raised);
    border: var(--hair) solid var(--rule);
    border-left: 3px solid var(--pen);
    padding: var(--space-s) var(--space-m) var(--space-s) var(--space-m);
    max-width: var(--measure);
  }
  .callout--warn { --pen: var(--accent); --pen-ink: var(--accent-ink); }
  .callout--tip { --pen: var(--ochre); --pen-ink: var(--ochre-ink); }
  .callout__label {
    font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--pen-ink); margin-bottom: 0.35rem;
  }
  .callout__title { color: var(--ink-2); text-transform: none; letter-spacing: 0.02em; }
  .callout__body { font-size: 0.95em; }
  .callout__body > :global(* + *) { margin-top: 0.6em; }
</style>
