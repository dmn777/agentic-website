---
// Syntax-highlighted code with the Plates themes, plus an optional filename tab.
import { Code } from 'astro:components';
import { plateLight, plateDark } from '../styles/shiki-themes';
interface Props { code: string; lang?: string; filename?: string }
const { code, lang = 'ts', filename } = Astro.props;
---
<div class="code-block">
  {(filename || lang) && (
    <div class="code-block__head"><span>{filename ?? ''}</span><span class="code-block__lang">{lang}</span></div>
  )}
  <Code code={code} lang={lang as any} themes={{ light: plateLight, dark: plateDark }} defaultColor={false} />
</div>
<style>
  .code-block { max-width: 100%; }
  .code-block__head {
    display: flex; justify-content: space-between; gap: 1rem;
    font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.04em;
    color: var(--ink-3); padding: 0.45rem 0.9rem 0.4rem 1.1rem;
    border: var(--hair) solid var(--rule); border-bottom: 0; border-left: 3px solid var(--accent);
    background: var(--paper-sunk);
  }
  .code-block__lang { text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .code-block :global(pre) { margin: 0; }
</style>
