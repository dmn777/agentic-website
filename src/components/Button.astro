---
// Plate buttons: square-cut, mono label, with a misregistered vermilion "second impression"
// that shifts on hover and closes up when pressed. <a> when href is given, else <button>.
import type { HTMLAttributes } from 'astro/types';
type Variant = 'primary' | 'secondary' | 'quiet';
interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: Variant;
  arrow?: boolean;
}
const { href, variant = 'primary', arrow = false, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['btn', `btn--${variant}`, cls]} href={href} type={href ? undefined : (rest.type ?? 'button')} {...rest}>
  <span class="btn__label"><slot /></span>{arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
</Tag>

<style>
  .btn {
    --shift: 4px;
    display: inline-flex; align-items: center; gap: 0.6em;
    min-height: 2.75rem;
    padding: 0.7em 1.15em 0.66em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.1;
    border: var(--stroke) solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
    transition: transform var(--dur-ui) var(--ease-out), box-shadow var(--dur-ui) var(--ease-out), background-color var(--dur-ui), color var(--dur-ui);
  }
  .btn--primary { background: var(--ink); color: var(--paper); box-shadow: var(--shift) var(--shift) 0 0 var(--accent); }
  .btn--secondary { background: transparent; color: var(--ink); box-shadow: var(--shift) var(--shift) 0 -1px var(--accent-wash); }
  .btn--quiet { border-color: transparent; background: transparent; color: var(--ink); padding-inline: 0.2em; }
  .btn--quiet .btn__label { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1.5px; text-underline-offset: 0.3em; }
  .btn:hover { color: inherit; }
  .btn--primary:hover { color: var(--paper); transform: translate(-1px, -1px); box-shadow: calc(var(--shift) + 2px) calc(var(--shift) + 2px) 0 0 var(--accent); }
  .btn--secondary:hover { background: var(--paper-raised); transform: translate(-1px, -1px); box-shadow: calc(var(--shift) + 1px) calc(var(--shift) + 1px) 0 0 var(--accent); }
  .btn--primary:active, .btn--secondary:active { transform: translate(var(--shift), var(--shift)); box-shadow: 0 0 0 0 var(--accent); }
  .btn__arrow { transition: transform var(--dur-ui) var(--ease-out); font-family: var(--font-text); font-size: 1.15em; line-height: 0; }
  .btn:hover .btn__arrow { transform: translateX(3px); }
  .btn:disabled, .btn:disabled:hover {
    background: transparent; color: var(--ink-3); border-style: dashed; border-color: var(--rule-strong);
    cursor: not-allowed; transform: none; box-shadow: none;
  }
</style>
