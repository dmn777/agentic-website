---
// Portable Text link mark: internal links get the site base; external ones open as usual.
import { joinBase, isInternal } from '../../lib/url';
const { node } = Astro.props as { node: { markDef: { href: string } } };
const href = node.markDef.href;
const target = isInternal(href) ? joinBase(import.meta.env.BASE_URL, href) : href;
---
<a href={target}><slot /></a>
