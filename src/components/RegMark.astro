---
// The brand mark: a printer's registration target, slightly misregistered (ink + vermilion).
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<svg class:list={['regmark', cls]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g class="regmark__accent" transform="translate(1.4 1.1)">
    <circle cx="16" cy="16" r="8.5" /><path d="M16 2v28M2 16h28" />
  </g>
  <g class="regmark__ink">
    <circle cx="16" cy="16" r="8.5" /><circle cx="16" cy="16" r="3" /><path d="M16 2v28M2 16h28" />
  </g>
</svg>
<style>
  .regmark { flex: none; overflow: visible; }
  .regmark g { fill: none; stroke-width: 1.5; }
  .regmark__ink { stroke: var(--ink); }
  .regmark__accent { stroke: var(--accent); opacity: 0.9; }
</style>
