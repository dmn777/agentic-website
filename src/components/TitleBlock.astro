---
// The footer is a technical-drawing title block: what the sheet is, who drew it, and who
// checked it (nobody; that's the point).
import { site } from '../data/site';
import { url } from '../lib/url';

const sheet = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const date = new Date().toISOString().slice(0, 10);
const sha = process.env.GITHUB_SHA?.slice(0, 7);
---
<footer class="title-block-wrap">
  <div class="wrap">
    <dl class="title-block">
      <div class="tb-title"><dt>Title</dt><dd><span class="tb-name">{site.title}</span> <span class="tb-tag">{site.tagline}</span></dd></div>
      <div class="tb-drawn"><dt>Drawn by</dt><dd>{site.builtBy}</dd></div>
      <div class="tb-sheet"><dt>Sheet</dt><dd class="mono">{sheet}</dd></div>
      <div class="tb-checked"><dt>Checked by</dt><dd>— <span class="muted">(unattended)</span></dd></div>
      <div><dt>Date</dt><dd class="mono">{date}</dd></div>
      <div class="tb-rev"><dt>Rev</dt><dd class="mono">{sha ?? 'local'}</dd></div>
      <div class="tb-links">
        <dt>See also</dt>
        <dd>
          <a href={site.repo}>Source on GitHub</a>
          <a href={url(site.v1)}>The Cowork version</a>
          {site.studio && <a href={site.studio}>Sanity Studio</a>}
        </dd>
      </div>
    </dl>
  </div>
</footer>

<style>
  .title-block-wrap { padding-block: var(--space-xl) var(--space-l); }
  .title-block {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: var(--stroke) solid var(--ink);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .title-block > div {
    padding: 0.55rem 0.8rem 0.65rem;
    border-right: var(--hair) solid var(--rule-strong);
    border-bottom: var(--hair) solid var(--rule-strong);
    min-width: 0;
  }
  /* row 1: title (4) | drawn by (2); row 2: sheet (2) | checked (2) | date | rev; row 3: links */
  .tb-title { grid-column: span 4; }
  .tb-drawn, .tb-sheet, .tb-checked { grid-column: span 2; }
  .tb-drawn, .tb-rev { border-right: 0 !important; }
  .tb-links { grid-column: 1 / -1; border-bottom: 0 !important; border-right: 0 !important; }
  dt {
    font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.2rem;
  }
  dd { color: var(--ink); overflow-wrap: anywhere; }
  dd.mono { font-size: var(--step--2); padding-top: 0.15em; }
  .tb-name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 520; }
  .tb-tag { color: var(--ink-2); font-style: italic; }
  .tb-links dd { display: flex; flex-wrap: wrap; gap: 0.2rem var(--space-m); }
  @media (max-width: 52rem) {
    .title-block { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tb-title, .tb-drawn, .tb-sheet, .tb-checked { grid-column: 1 / -1; border-right: 0 !important; }
    .tb-rev { border-right: 0 !important; }
  }
</style>
