---
import { site, nav } from '../data/site';
import { url } from '../lib/url';
import RegMark from './RegMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname;
const isCurrent = (href: string, match?: string) =>
  here === url(href) || (match ? here.startsWith(url(match)) : false);
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={url('/')}>
      <RegMark size={26} />
      <span class="brand__name">{site.title}</span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href, item.match) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
  <div class="ruler" aria-hidden="true"></div>
</header>

<style>
  .site-header { position: relative; }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-s);
    padding-block: var(--space-s) var(--space-xs);
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    text-decoration: none; color: var(--ink);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.3rem + 0.6vw, 1.85rem);
    font-weight: 520;
    letter-spacing: 0.01em;
    line-height: 1;
    padding-top: 0.1em;
  }
  .brand:hover .brand__name { color: var(--ink); }
  .site-nav { display: flex; align-items: center; gap: var(--space-2xs); }
  .site-nav ul { display: flex; flex-wrap: wrap; gap: 0.15rem var(--space-s); list-style: none; padding: 0; }
  .site-nav a {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.6rem;
    position: relative;
  }
  .site-nav a:hover { color: var(--ink); }
  .site-nav a[aria-current='page'] { color: var(--ink); }
  .site-nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.3rem;
    height: 2px; background: var(--accent);
  }
  /* The header rule is a ruler: hairline + minor ticks every 8 px, major every 80 px. */
  .ruler {
    height: 9px;
    border-top: var(--hair) solid var(--rule-strong);
    background:
      repeating-linear-gradient(to right, var(--rule-strong) 0 1px, transparent 1px 80px) top left / 100% 8px no-repeat,
      repeating-linear-gradient(to right, var(--rule) 0 1px, transparent 1px 8px) top left / 100% 4px no-repeat;
    opacity: 0.9;
  }
  @media (max-width: 30rem) {
    .site-header__inner { row-gap: 0; }
    .site-nav { width: 100%; justify-content: space-between; }
  }
</style>
