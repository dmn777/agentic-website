---
// Layout for a Lab plate: plate header (number, kind, series, title, lede, specimen),
// the page body, and a pager to the neighbouring plates. Metadata comes from src/data/lab.ts.
import Base from './Base.astro';
import Plot from '../components/Plot.astro';
import { lab, labEntry, roman, seriesById, platesIn } from '../data/lab';
import { url } from '../lib/url';

interface Props { slug: string; lede: string; description?: string }
const { slug, lede, description } = Astro.props;
const entry = labEntry(slug);
// A draft sees its listed neighbours, but they don't see it (see lab.ts).
const ordered = [...lab, ...(entry.draft ? [entry] : [])].sort((a, b) => a.plate - b.plate);
const i = ordered.findIndex((e) => e.slug === slug);
const prev = ordered[i - 1], next = ordered[i + 1];
const ser = seriesById(entry.series);
const inSeries = ser ? platesIn(ser.id) : [];
const seriesPos = inSeries.findIndex((e) => e.slug === slug) + 1;
---
<Base title={entry.title} description={description ?? entry.blurb} noindex={entry.draft}>
  <article class="wrap labpage" data-lab-kind={entry.kind} data-lab-slug={entry.slug}>
    <header class="labpage__head">
      <p class="label labpage__plate">Pl. {roman(entry.plate)}<br /><span>{entry.kind}</span></p>
      <p class="label labpage__kicker">
        <span class="labpage__kicker-plate">Pl. {roman(entry.plate)} · {entry.kind}</span>{ser && <span class="labpage__kicker-series"> · <a href={url(ser.href)}>{ser.title}</a> {seriesPos}/{inSeries.length}</span>}
      </p>
      {ser && <p class="label labpage__series"><a href={url(ser.href)}>{ser.title}</a> · {seriesPos} of {inSeries.length}</p>}
      <h1 class="labpage__title">{entry.title}</h1>
      <p class="lede labpage__lede">{lede}</p>
      <div class="labpage__specimen" aria-hidden="true">
        <Plot seed={`lab/${entry.slug}`} species={entry.species} detail={0.7} draw duration={2200} />
      </div>
    </header>
    <div class="labpage__body">
      <slot />
    </div>
    <nav class="labpage__pager plate-grid" aria-label="Other plates">
      <p class="margin label">Continue</p>
      <div class="pager">
        {prev ? <a class="pager__link" href={url(`/lab/${prev.slug}/`)}><span class="label">← Pl. {roman(prev.plate)}</span><span class="pager__title">{prev.title}</span></a> : <span />}
        {next ? <a class="pager__link pager__link--next" href={url(`/lab/${next.slug}/`)}><span class="label">Pl. {roman(next.plate)} →</span><span class="pager__title">{next.title}</span></a> : <a class="pager__link pager__link--next" href={url('/lab/')}><span class="label">Index →</span><span class="pager__title">All plates</span></a>}
      </div>
    </nav>
  </article>
</Base>

<style>
  .labpage { padding-block: var(--space-xl) 0; }
  /* The header is one flat grid so its parts can be rearranged per width:
     desktop: margin label | series + title + lede | specimen
     mobile:  one kicker line; title beside a small specimen; the lede at full width. */
  .labpage__head {
    display: grid;
    grid-template-columns: var(--margin-col) minmax(0, 1fr) minmax(0, 13rem);
    grid-template-areas: "plate series spec" "plate title spec" "plate lede spec";
    grid-template-rows: auto auto 1fr;
    column-gap: var(--space-l);
    align-items: start;
    padding-bottom: var(--space-l);
    border-bottom: var(--hair) solid var(--rule);
  }
  .labpage__plate { grid-area: plate; color: var(--accent-ink); padding-top: 0.45em; }
  .labpage__plate span { color: var(--ink-3); }
  .labpage__kicker { display: none; }
  .labpage__series { grid-area: series; margin-bottom: var(--space-2xs); }
  .labpage__series a, .labpage__kicker-series a { color: inherit; text-decoration-color: var(--accent); }
  .labpage__title { grid-area: title; margin-bottom: var(--space-s); }
  .labpage__lede { grid-area: lede; }
  .labpage__specimen { grid-area: spec; width: 100%; max-width: 13rem; justify-self: end; }
  .labpage__body { padding-block: var(--space-l); }
  .labpage__pager { padding-block: var(--space-l); border-top: var(--hair) solid var(--rule); }
  .pager { display: flex; justify-content: space-between; gap: var(--space-m); flex-wrap: wrap; }
  .pager__link { display: grid; gap: 0.2rem; text-decoration: none; max-width: 22rem; }
  .pager__link--next { text-align: right; margin-left: auto; }
  .pager__title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1.5px; text-underline-offset: 0.2em; }
  .pager__link .label { color: var(--accent-ink); }
  @media (max-width: 52rem) {
    .labpage__head {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      grid-template-areas: "kicker kicker" "title spec" "lede lede";
      grid-template-rows: auto auto auto;
      column-gap: var(--space-s);
    }
    .labpage__plate, .labpage__series { display: none; }
    .labpage__kicker { display: block; grid-area: kicker; margin-bottom: var(--space-2xs); }
    .labpage__kicker-plate { color: var(--accent-ink); }
    .labpage__title { align-self: center; margin-bottom: var(--space-2xs); }
    .labpage__specimen { max-width: 5.5rem; align-self: center; }
  }
</style>
