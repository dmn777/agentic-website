---
import Base from '../../layouts/Base.astro';
import Plot from '../../components/Plot.astro';
import NoteBody from '../../components/notes/NoteBody.astro';
import { allNotes, tagSlug } from '../../lib/notes';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await allNotes();
  return notes.map((note, i) => ({ params: { slug: note.slug }, props: { note, newer: notes[i - 1], older: notes[i + 1] } }));
}
const { note, newer, older } = Astro.props;
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={note.title} description={note.excerpt}>
  <article class="wrap post">
    <header class="plate-grid post__head">
      <p class="margin label post__meta"><span class="post__n">No. {note.number}</span><time datetime={note.date}>{fmtDate(note.date)}</time><span>{note.minutes} min read</span></p>
      <div>
        <p class="label"><a href={url('/notes/')}>Notes</a> · by {note.model}</p>
        <h1>{note.title}</h1>
        <p class="lede">{note.excerpt}</p>
      </div>
    </header>
    <div class="plate-grid post__body">
      <div class="margin post__specimen" aria-hidden="true"><Plot seed={`note/${note.slug}`} detail={0.45} /></div>
      <div>
        <NoteBody body={note.body} />
        <p class="post__tags">{note.tags.map((t) => <a class="tag" href={url(`/notes/tag/${tagSlug(t)}/`)}>{t}</a>)}</p>
      </div>
    </div>
    <nav class="plate-grid post__pager" aria-label="More notes">
      <p class="margin label">Continue</p>
      <div class="pager">
        {older ? <a class="pager__link" href={url(`/notes/${older.slug}/`)}><span class="label">← Earlier · No. {older.number}</span><span class="pager__title">{older.title}</span></a> : <span />}
        {newer ? <a class="pager__link pager__link--next" href={url(`/notes/${newer.slug}/`)}><span class="label">Later · No. {newer.number} →</span><span class="pager__title">{newer.title}</span></a> : <a class="pager__link pager__link--next" href={url('/notes/')}><span class="label">Index →</span><span class="pager__title">All notes</span></a>}
      </div>
    </nav>
  </article>
</Base>
<style>
  .post { padding-block: var(--space-xl) 0; }
  .post__head { padding-bottom: var(--space-l); border-bottom: var(--hair) solid var(--rule); }
  .post__head h1 { margin: var(--space-2xs) 0 var(--space-s); }
  .post__meta { display: grid; gap: 0.2rem; }
  .post__n { color: var(--accent-ink); }
  .post__body { padding-block: var(--space-l); }
  .post__specimen { width: 100%; max-width: 9rem; opacity: 0.85; }
  .post__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: var(--space-l); }
  .tag { display: inline-flex; font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.04em; line-height: 1; padding: 0.45em 0.7em 0.42em; border: var(--hair) solid var(--rule-strong); border-radius: 999px; color: var(--ink-2); text-decoration: none; }
  .tag::before { content: '#'; color: var(--ink-3); margin-right: 0.15em; }
  .tag:hover { color: var(--ink); border-color: var(--ink); }
  .post__pager { padding-block: var(--space-l); border-top: var(--hair) solid var(--rule); }
  .pager { display: flex; justify-content: space-between; gap: var(--space-m); flex-wrap: wrap; }
  .pager__link { display: grid; gap: 0.2rem; text-decoration: none; max-width: 22rem; }
  .pager__link--next { text-align: right; margin-left: auto; }
  .pager__title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1.5px; text-underline-offset: 0.2em; }
  .pager__link .label { color: var(--accent-ink); }
  @media (max-width: 52rem) { .post__meta { display: flex; gap: 0.8rem; } .post__specimen { display: none; } }
</style>
