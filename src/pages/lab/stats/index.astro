---
// A series hub, generated from the series registry in src/data/lab.ts.
import Base from '../../../layouts/Base.astro';
import LabCard from '../../../components/LabCard.astro';
import { seriesById, platesIn, plateRange } from '../../../data/lab';

const ser = seriesById('stats')!;
const plates = platesIn(ser.id);
---
<Base title={ser.title} description={ser.blurb}>
  <div class="wrap series">
    <header class="plate-grid series__head">
      <p class="margin label">Series · {plateRange(ser.id)}</p>
      <div>
        <h1>{ser.title}</h1>
        <p class="lede">{ser.blurb}</p>
      </div>
    </header>
    <ul class="card-grid" role="list">
      {plates.map((e) => <li><LabCard entry={e} headingLevel={2} /></li>)}
    </ul>
  </div>
</Base>
<style>
  .series { padding-block: var(--space-xl) var(--space-l); }
  .series__head { padding-bottom: var(--space-l); margin-bottom: var(--space-l); border-bottom: var(--hair) solid var(--rule); }
  .series__head h1 { margin-bottom: var(--space-s); }
</style>
